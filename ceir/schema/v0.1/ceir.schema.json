{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-finops-meter:ceir:v0.1",
  "title": "Cost Event Interchange Record",
  "description": "A single local-first agent inference cost event. Decimal USD amounts are strings to preserve fixed-point precision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "ts",
    "harness",
    "workflow",
    "case_id",
    "outcome",
    "model",
    "tokens_in",
    "tokens_out",
    "cost_usd",
    "retries",
    "tool_costs",
    "source"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for one inference run. Log validation rejects duplicates."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "RFC 3339 date-time with an explicit UTC offset."
    },
    "harness": {
      "type": "string",
      "minLength": 1,
      "description": "Harness or collector integration that produced the event."
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "description": "Workflow label associated with the run."
    },
    "case_id": {
      "description": "Case identifier; null is the explicit unattributed state.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "escalated",
        "abandoned"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model identifier used for inference."
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cost_usd": {
      "$ref": "#/$defs/fixed_usd",
      "description": "Non-negative fixed-point USD amount with at most six fractional digits."
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tool_costs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_cost"
      },
      "description": "Optional typed tool charges; an empty array means no separate tool charges."
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "$defs": {
    "fixed_usd": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
      "description": "Decimal USD string: no sign, exponent, leading zero, or more than six fractional digits."
    },
    "tool_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cost_usd"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Stable tool-cost category or tool identifier."
        },
        "cost_usd": {
          "$ref": "#/$defs/fixed_usd"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector_id",
        "attribution"
      ],
      "properties": {
        "collector_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier of the collector or adapter."
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cwd",
            "git",
            "task_label"
          ],
          "properties": {
            "cwd": {
              "type": "string",
              "minLength": 1,
              "description": "Working directory from which the workflow/case was produced."
            },
            "git": {
              "type": "string",
              "minLength": 1,
              "description": "Repository/ref/commit provenance, or an explicit local-state label."
            },
            "task_label": {
              "type": "string",
              "minLength": 1,
              "description": "Task label that produced the workflow/case."
            }
          }
        }
      }
    }
  }
}
